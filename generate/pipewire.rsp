# Upstream marks these "not part of ABI" with a leading underscore: each is one past
# the end of a range, never a value anything sends. Left out rather than shown to a
# caller as though it were a choice.
--exclude
_SPA_DATA_LAST
--exclude
_SPA_META_LAST
--exclude
_SPA_TYPE_COMMAND_LAST
--exclude
_SPA_TYPE_EVENT_LAST
--exclude
_SPA_TYPE_LAST
--exclude
_SPA_TYPE_OBJECT_LAST
--exclude
_SPA_TYPE_POINTER_LAST
# <<< end naming block

--include-directory
/usr/include/pipewire-0.3
--include-directory
/usr/include/spa-0.2
--include-directory
/usr/include/x86_64-linux-gnu
--include-directory
/usr/include

--namespace
PipeWire.NET.Interop

--method-class-name
Native

--library-path
libpipewire-0.3

--language
c

# Exclude functions/types that pull in unresolvable libc types (FILE*, va_list, timespec)
# or that target the internal PipeWire protocol/loop subsystem which the public C# API
# does not expose. The opaque pointer types (pw_proxy*, pw_mempool*, pw_protocol*) are
# left in: their forward declarations generate empty record types, which is correct.
--exclude
pw_log_log
--exclude
pw_log_logv
--exclude
pw_log_logt
--exclude
pw_log_logtv
--exclude
pw_log_log_object
--exclude
pw_logv
--exclude
pw_vlog
--exclude
pw_log_set_funcs
--exclude
pw_log_topic_register_enum
--exclude
pw_log_topic_unregister_enum
--exclude
pw_properties_setva
--exclude
pw_properties_new_va
--exclude
pw_properties_new
--exclude
pw_properties_serialize_dict
--exclude
pw_split_strv
--exclude
pw_free_strv
--exclude
pw_split_walk
--exclude
pw_strip
--exclude
pw_protocol_implementation
--exclude
pw_protocol_get_implementation
--exclude
spa_loop_utils_methods
--exclude
spa_system_methods
--exclude
spa_loop_control_methods
--exclude
spa_loop_control_hooks
--exclude
__va_list_tag
--exclude
_IO_FILE
--exclude
_IO_marker
--exclude
_IO_codecvt
--exclude
_IO_wide_data
--exclude
timespec
--exclude
itimerspec
# thread-loop timed-wait variants take struct timespec* (excluded above);
# we use the plain pw_thread_loop_wait instead.
--exclude
pw_thread_loop_get_time
--exclude
pw_thread_loop_timed_wait_full

--generate
disable-runtime-marshalling
file-scoped-namespaces
helper-types
funcs-with-body=false

--config
file=multi
codegen=preview
types=unix
# generate-macro-bindings is DISABLED: many PipeWire macros use CompoundLiteralExpr
# and the SPA_POD_INIT_* family, which ClangSharp 21 cannot translate. Enabling it
# causes a fatal generator error. Version-style macro constants (PW_VERSION_*) are
# hand-defined in the high-level wrappers where needed.
