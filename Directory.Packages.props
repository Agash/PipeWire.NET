<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <!-- A stable target should not carry a preview dependency: net10 consumers would otherwise be
         forced onto an unreleased package for no API they use. Kept split across the merge - the
         bump on main moved a single unconditional entry, which would put the preview back on net10. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.1.26425.128" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.0" />

    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>
</Project>
